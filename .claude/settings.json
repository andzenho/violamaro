{
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    }
  },
  "enabledPlugins": {
    "watch@claude-video": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(python3 skripty/plan.py:*)",
      "Bash(python3 skripty/ves.py:*)",
      "Bash(python3 skripty/proverka.py:*)",
      "Bash(python3 skripty/razbor.py:*)",
      "Bash(python3 skripty/razbor_kommentov.py:*)",
      "Bash(python3 skripty/perenos.py:*)",
      "Bash(python3 skripty/karta_korpusa.py:*)",
      "Bash(python3 skripty/kp_export.py:*)",
      "Bash(python3 skripty/lending_promt.py:*)",
      "Bash(python3 skripty/kontrast.py:*)",
      "Read(//home/user/violamaro/**)",
      "Glob(//home/user/violamaro/**)",
      "Grep(//home/user/violamaro/**)",
      "Bash(python3 skripty/karta.py:*)",
      "Bash(python3 skripty/oglavlenie.py:*)",
      "Bash(python3 skripty/sheets_sync.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/skripty/session_pull.sh\" 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/skripty/avtosohran.sh\" 2>/dev/null"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/strazh_chteniya.py\""
          }
        ]
      }
    ]
  }
}
